<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>CrucibleAI</RootNamespace>
    <AssemblyName>Geekmotors.Crucible</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Geekmotors.Crucible</PackageId>
    <Description>Semantic assertions for code that calls LLMs: an AI judge checks that a reply means what it should, given the facts your system knew, over repeated runs gated on a pass rate. Works in any test framework through Crucible.Gate; the judge is an OpenRouter, OpenAI or OpenAI-compatible model, or any Microsoft.Extensions.AI IChatClient.</Description>
    <PackageTags>llm;ai;testing;llm-as-judge;semantic-assertions;evaluation;nondeterminism</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RepositoryRoot)/schemas/*.md" LogicalName="schemas/%(Filename)%(Extension)" LinkBase="schemas" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <AssemblyMetadata Include="CrucibleSpec" Value="dotnet-v$(Version)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Geekmotors.Crucible.Tests" />
    <InternalsVisibleTo Include="Geekmotors.Crucible.Xunit" />
    <InternalsVisibleTo Include="Geekmotors.Crucible.Xunit.Fixture" />
    <InternalsVisibleTo Include="Geekmotors.Crucible.Xunit.Tests" />
  </ItemGroup>
</Project>
